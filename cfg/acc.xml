  <plugin ID="Reactive Script Editor">
   <library code="--[[ Helper function to create a series from arrays

 new_series: a series previously created with ScatterXY.new(name)
 prefix:     prefix of the timeseries, before the index of the array
 suffix_X:   suffix to complete the name of the series containing the X value. If [nil], use the index of the array.
 suffix_Y:   suffix to complete the name of the series containing the Y value
 timestamp:   usually the tracker_time variable
--]]

function CreateSeriesFromArray( new_series, prefix, suffix_X, suffix_Y, timestamp )
  new_series:clear()
  index = 0
  while(true) do
    x = index;
    if suffix_X ~= nil then
      series_x = TimeseriesView.find( string.format( &quot;%s[%d]/%s&quot;, prefix, index, suffix_X) )
      if series_x == nil then break end
      x = series_x:atTime(timestamp)
      if x == nil then break end
    end
    series_y = TimeseriesView.find( string.format( &quot;%s[%d]/%s&quot;, prefix, index, suffix_Y) )
    if series_y == nil then break end
    y = series_y:atTime(timestamp)
    if y == nil then break end
    new_series:push_back(x,y)
    index = index+1
  end
end

-- X = arc length (s - s0) when available; Y = PlanningPoint.speed (m/s)
function FillPlanSpeedProfile(scatter, prefix, timestamp)
  scatter:clear()
  idx = 0
  s0 = nil
  x0 = nil
  while idx &lt; 120 do
    series_v = TimeseriesView.find(string.format(&quot;%s[%d]/speed&quot;, prefix, idx))
    if series_v == nil then break end
    v_val = series_v:atTime(timestamp)
    if v_val == nil then break end
    x_val = nil
    series_s = TimeseriesView.find(string.format(&quot;%s[%d]/s&quot;, prefix, idx))
    if series_s ~= nil then
      s_val = series_s:atTime(timestamp)
      if s_val ~= nil then
        if s0 == nil then s0 = s_val end
        x_val = s_val - s0
      end
    end
    if x_val == nil then
      series_x = TimeseriesView.find(string.format(&quot;%s[%d]/x&quot;, prefix, idx))
      if series_x ~= nil then
        x_at = series_x:atTime(timestamp)
        if x_at ~= nil then
          if x0 == nil then x0 = x_at end
          x_val = x_at - x0
        end
      end
    end
    if x_val == nil then
      x_val = idx
    end
    scatter:push_back(x_val, v_val)
    idx = idx + 1
  end
end

-- X = lon MPC ref_s_vec (relative to point 0); Y = ref_vel_vec (m/s), 26 points @ 0.1s
function FillLonMpcRefProfile(scatter, prefix, timestamp)
  scatter:clear()
  idx = 0
  s0 = nil
  while idx &lt; 30 do
    series_v = TimeseriesView.find(string.format(&quot;%s/ref_vel_vec[%d]&quot;, prefix, idx))
    if series_v == nil then break end
    v_val = series_v:atTime(timestamp)
    if v_val == nil then break end
    x_val = nil
    series_s = TimeseriesView.find(string.format(&quot;%s/ref_s_vec[%d]&quot;, prefix, idx))
    if series_s ~= nil then
      s_val = series_s:atTime(timestamp)
      if s_val ~= nil then
        if s0 == nil then s0 = s_val end
        x_val = s_val - s0
      end
    end
    if x_val == nil then
      x_val = idx * 0.1
    end
    scatter:push_back(x_val, v_val)
    idx = idx + 1
  end
end
